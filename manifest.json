{
  "manifest_version": 3,
  "name": "GitHub to CodeMonkey Games Launcher",
  "version": "1.0",
  "description": "Adds a button to GitHub repositories to add them to the CodeMonkey Games launcher.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/content.js"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ]
}
